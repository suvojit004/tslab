<!DOCTYPE html><html lang="en">
<%- include('partials/head', { description: 'Explore TS Lab technology partners and find products suited to your security and IT priorities.' }) %>
<body><%- include('partials/header') %><main id="main">
<section class="page-hero"><%- include('partials/hero-background') %><div class="wrap"><a class="breadcrumb" href="/">Home /</a><span class="breadcrumb"> Technology partners</span><div class="page-heading"><div><p class="eyebrow">THE TS LAB PORTFOLIO</p><h1>The right technology.<br><em>For your next step.</em></h1></div><p class="intro">Explore each partner through the needs of your business—from protecting data and devices to managing connected infrastructure.</p></div></div></section>
<section class="wrap section"><div class="filters" role="group" aria-label="Filter partners"><% ['All partners', ...new Set(partners.map(p => p.category))].forEach((category,i) => { %><button data-filter="<%= category %>" aria-pressed="<%= i === 0 %>"><%= category %></button><% }); %></div><p id="result-count" class="sr-only" aria-live="polite">Showing 11 partners</p><div class="partner-grid"><% partners.forEach(partner => { %><a class="partner partner-card-link" href="/partners/<%= partner.slug %>" data-category="<%= partner.category %>" aria-label="Explore <%= partner.name %>"><span class="eyebrow"><%= partner.category %></span><h3><%= partner.name %></h3><p><%= partner.summary %></p></a><% }); %></div></section>
</main><%- include('partials/footer') %></body></html>
