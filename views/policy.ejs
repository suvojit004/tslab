<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { description: policy.description }) %>
<body>
<%- include('partials/header') %>
<main id="main">
  <section class="page-hero"><%- include('partials/hero-background') %><div class="wrap"><a class="breadcrumb" href="/">Home /</a><span class="breadcrumb"> <%= policy.title %></span><div class="page-heading"><div><p class="eyebrow">TS LAB PVT LTD</p><h1><%= policy.title %></h1></div><p class="intro"><%= policy.description %></p></div></div></section>
  <div class="wrap section policy-layout">
    <aside class="policy-contents" aria-label="On this page"><p class="eyebrow">ON THIS PAGE</p><% policy.sections.forEach(section => { %><a href="#<%= section[0] %>"><%= section[1] %></a><% }); %><a href="#policy-contact">Contact TS Lab</a></aside>
    <article class="policy-copy"><div class="policy-draft"><strong>Draft for review</strong><p>Prepared 16 November 2026. Company approval and legal review are required before this becomes a final published policy.</p></div><p class="policy-intro"><%= policy.introduction %></p><% policy.sections.forEach((section,i) => { %><section id="<%= section[0] %>"><h2><%= i+1 %>. <%= section[1] %></h2><p><%= section[2] %></p><% if (section[0] === 'privacy') { %><a class="text-link" href="/privacy-policy">Read the Privacy Policy ↗</a><% } %></section><% }); %><section id="policy-contact"><h2>Contact TS Lab</h2><p>For questions about this draft, contact TS Lab Pvt Ltd.</p><a href="mailto:rabindra@tslab.in">rabindra@tslab.in</a><br><a href="tel:+919830090055">+91 98300 90055</a><p><a class="text-link" href="/contact">All contact options ↗</a></p></section></article>
  </div>
</main>
<%- include('partials/footer') %>
</body></html>
